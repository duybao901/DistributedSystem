{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "JwtOption": {
    "Issuer": "http://localhost:6000",
    "Audience": "http://localhost:6000",
    "SecretKey": "oEZqUKrrKDKP7A9OtrB4GfPGJ92vLDpK", // Remove this on production environment
    "ExpireMin": 5
  },
  "ReverseProxy": {
    "Routes": {
      "commandApiRoute": {
        "ClusterId": "commandApiCluster",
        "Match": {
          "Path": "command-api/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "api/{**catch-all}"
          }
        ]
      },
      "queryApiRoute": {
        "ClusterId": "queryApiCluster",
        "Match": {
          "Path": "{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "api/{**catch-all}"
          }
        ]
      }
    },
    "Clusters": {
      "commandApiCluster": {
        "Destinations": {
          "Destination1": {
            "Address": "http://localhost:3000"
          }
        }
      },
      "queryApiCluster": {
        "Destinations": {
          "Destination1": {
            "Address": "http://localhost:4000"
          }
        }
      }
    }
  }
}
